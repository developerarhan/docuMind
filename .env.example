# ==============================================================================
# docuMind Cloud Deployment Environment Variables (100% Free Tier)
# ==============================================================================

# --- DJANGO SETTINGS ---
DEBUG=False
SECRET_KEY=your-secure-random-secret-key-at-least-50-characters
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://your-frontend-project.vercel.app,http://localhost:5173
CORS_ALLOW_ALL_ORIGINS=False

# --- DATABASE (Supabase PostgreSQL) ---
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:your-db-password@db.your-supabase-ref.supabase.co:5432/postgres?sslmode=require

# --- LLM API (Groq) ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- EMBEDDINGS (Google Gemini - Free Tier, No Credit Card) ---
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# --- VECTOR STORE (Supabase pgvector) ---
VECTOR_STORE_TYPE=pgvector
USE_PGVECTOR=true

# --- CELERY & BROKER (Upstash Redis Free over standard TLS) ---
# Format: rediss://:PASSWORD@HOST:PORT
UPSTASH_REDIS_URL=rediss://:your-upstash-password@your-endpoint.upstash.io:6379

# --- PDF FILE STORAGE (Supabase Storage via native supabase-py SDK) ---
# Create a public bucket in Supabase Storage named 'documind-pdfs'
# Get URL and Anon/Service Role Key from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_STORAGE_BUCKET=documind-pdfs
